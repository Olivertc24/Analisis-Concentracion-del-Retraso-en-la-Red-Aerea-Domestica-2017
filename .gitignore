# --- Bases de datos --------------------------------------------------------
# La base original (travel.sqlite, 104 MB) y las que se derivan de ella no se
# versionan: se reconstruyen con los scripts de "Base de datos/".
travel.sqlite
*.db
*.db-wal
*.db-shm
*.sqlite
*.duckdb

# EXCEPCION: la base analitica SI se versiona, en data/. Pesa 5 MB y es lo que
# hace que el aplicativo sea autocontenido: sin ella, un despliegue no tendria
# datos. Se versiona la de SQLite y no la de DuckDB a proposito, porque el
# formato de SQLite es estable y el de DuckDB puede cambiar entre versiones.
!data/travel_analitica.sqlite

# EXCEPCION: las cuatro bases del trabajo tambien viajan, en "Base de datos/".
# Las dos grandes van COMPRIMIDAS porque GitHub rechaza cualquier archivo de
# mas de 100 MB: travel.sqlite pesa 104,6 MB y travel_normalizada 186,4 MB.
# Comprimidas quedan en 29 y 56 MB. Hay que descomprimirlas antes de usarlas:
#     gunzip -k travel.sqlite.gz
!Base de datos/travel_analitica.duckdb

# --- Credenciales ----------------------------------------------------------
# Nunca, bajo ningun concepto. La regla existe antes que el archivo.
.streamlit/secrets.toml
.env
*.token

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.Python
env/
venv/
.venv/
*.egg-info/

# --- Entornos y editores ---------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp

# --- Salidas temporales ----------------------------------------------------
*.log
.ipynb_checkpoints/

# --- Tableau ---------------------------------------------------------------
# Archivos temporales de recuperacion que Tableau deja junto al libro.
*.twbr
.~*
# La extraccion Hyper viaja dentro del .twbx, asi que no se versiona aparte.
*.hyper

          <ordinal>6</ordinal>
          <local-type>integer</local-type>
          <aggregation>Sum</aggregation>
          <contains-null>true</contains-null>
        </metadata-record>
        <metadata-record class='column'>
          <remote-name>minutos</remote-name>
          <remote-type>20</remote-type>
          <local-name>[minutos]</local-name>
          <parent-name>[tiempo]</parent-name>
          <remote-alias>minutos</remote-alias>
          <ordinal>7</ordinal>
          <local-type>integer</local-type>
          <aggregation>Count</aggregation>
          <contains-null>true</contains-null>
        </metadata-record>
        <metadata-record class='column'>
          <remote-name>prolongadas</remote-name>
          <remote-type>20</remote-type>
          <local-name>[prolongadas]</local-name>
          <parent-name>[tiempo]</parent-name>
          <remote-alias>prolongadas</remote-alias>
          <ordinal>8</ordinal>
          <local-type>integer</local-type>
          <aggregation>Sum</aggregation>
          <contains-null>true</contains-null>
        </metadata-record>
      </metadata-records>
    </connection>
    <aliases enabled='yes' />
    <column datatype='integer' name="[hora]" role='dimension' type='ordinal' />
    <column datatype='string' name="[etiqueta_hora]" role='dimension' type='nominal' />
    <column datatype='string' name="[bloque]" role='dimension' type='nominal' />
    <column datatype='integer' name="[orden_bloque]" role='dimension' type='ordinal' />
    <column datatype='string' name="[nombre_dia]" role='dimension' type='nominal' />
    <column datatype='integer' name="[dia_semana]" role='dimension' type='ordinal' />
    <column datatype='integer' name="[vuelos]" role='measure' type='quantitative' />
    <column datatype='integer' name="[minutos]" role='dimension' type='ordinal' />
    <column datatype='integer' name="[prolongadas]" role='measure' type='quantitative' />
    <column caption="Demora media de salida (min)" datatype='real' default-format="n#,##0.00" name='[DemoraMedia]' role='measure' type='quantitative'>
      <calculation class='tableau' formula="SUM([minutos]) / SUM([vuelos])" scope-isolation='false' />
    </column>
    <column caption="Dia de la semana" datatype='string' name='[DiaOrdenado]' role='dimension' type='nominal'>
      <calculation class='tableau' formula="STR([dia_semana]) + '. ' + [nombre_dia]" scope-isolation='false' />
    </column>
    <column-instance column='[DiaOrdenado]' derivation='None' name="[none:DiaOrdenado:nk]" pivot='key' type='nominal' />
    <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
  </datasource>
  </datasources>
  <worksheets>
    <worksheet name="Cobertura del registro">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#35505C' fontsize='11'>Vuelos programados y vuelos con hora real, por fecha</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Cobertura" name='federated.cobertura' />
          </datasources>
          <datasource-dependencies datasource='federated.cobertura'>
            <column datatype='date' name="[fecha]" role='dimension' type='ordinal' />
            <column datatype='integer' name="[programados]" role='measure' type='quantitative' />
            <column datatype='integer' name="[operados]" role='measure' type='quantitative' />
            <column-instance column="[fecha]" derivation='None' name="[none:fecha:ok]" pivot='key' type='ordinal' />
            <column-instance column="[programados]" derivation='Sum' name="[sum:programados:qk]" pivot='key' type='quantitative' />
            <column-instance column="[operados]" derivation='Sum' name="[sum:operados:qk]" pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='display-field-labels' scope='rows' value='false' />
            <format attr='display-field-labels' scope='cols' value='false' />
          </style-rule>
          <style-rule element='pane'>
            <format attr='background-color' value='#FFFFFF' />
          </style-rule>
          <style-rule element='axis'>
            <format attr='color' value='#6E8894' />
          </style-rule>
          <style-rule element='header'>
            <format attr='color' value='#35505C' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[federated.cobertura].[sum:programados:qk] + [federated.cobertura].[sum:operados:qk]</rows>
        <cols>[federated.cobertura].[none:fecha:ok]</cols>
      </table>
      <simple-id uuid='{F4E77B07-A44C-590F-A1A9-6AB3BDFF0BE4}' />
    </worksheet>
    <worksheet name="La forma de la distribucion">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#35505C' fontsize='11'>Vuelos por minuto de demora de salida. Entre 12 y 123 no hay ninguno</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Distribucion" name='federated.distribucion' />
          </datasources>
          <datasource-dependencies datasource='federated.distribucion'>
            <column datatype='integer' name="[minutos]" role='dimension' type='ordinal' />
            <column datatype='integer' name="[vuelos]" role='measure' type='quantitative' />
            <column caption="Regimen de demora" datatype='string' name='[RegimenDemora]' role='dimension' type='nominal'>
              <calculation class='tableau' formula="STR([orden_regimen]) + '. ' + [regimen]" scope-isolation='false' />
            </column>
            <column-instance column="[minutos]" derivation='None' name="[none:minutos:ok]" pivot='key' type='ordinal' />
            <column-instance column="[vuelos]" derivation='Sum' name="[sum:vuelos:qk]" pivot='key' type='quantitative' />
            <column-instance column='[RegimenDemora]' derivation='None' name="[none:RegimenDemora:nk]" pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='display-field-labels' scope='rows' value='false' />
            <format attr='display-field-labels' scope='cols' value='false' />
          </style-rule>
          <style-rule element='pane'>
            <format attr='background-color' value='#FFFFFF' />
          </style-rule>
          <style-rule element='axis'>
            <format attr='color' value='#6E8894' />
          </style-rule>
          <style-rule element='header'>
            <format attr='color' value='#35505C' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column="[federated.distribucion].[none:RegimenDemora:nk]" />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.distribucion].[sum:vuelos:qk]</rows>
        <cols>[federated.distribucion].[none:minutos:ok]</cols>
      </table>
      <simple-id uuid='{79A97A45-BCDE-5B02-A411-DDB78FA8302D}' />
    </worksheet>
    <worksheet name="El mapa de la red">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#35505C' fontsize='11'>Tamano por volumen, color por indice de concentracion</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Aeropuertos" name='federated.aeropuertos' />
          </datasources>
          <datasource-dependencies datasource='federated.aeropuertos'>
            <column datatype='string' name="[codigo]" role='dimension' type='nominal' />
            <column datatype='integer' name="[vuelos]" role='measure' type='quantitative' />
            <column datatype='real' name="[longitud]" role='measure' semantic-role="[Longitude]" type='quantitative' />
            <column datatype='real' name="[latitud]" role='measure' semantic-role="[Latitude]" type='quantitative' />
            <column caption="Indice de concentracion" datatype='real' default-format="n#,##0.000" name='[Indice]' role='measure' type='quantitative'>
              <calculation class='tableau' formula="(SUM([minutos]) / TOTAL(SUM([minutos]))) / (SUM([vuelos]) / TOTAL(SUM([vuelos])))" scope-isolation='false' />
            </column>
            <column-instance column="[codigo]" derivation='None' name="[none:codigo:nk]" pivot='key' type='nominal' />
            <column-instance column="[vuelos]" derivation='Sum' name="[sum:vuelos:qk]" pivot='key' type='quantitative' />
            <column-instance column="[longitud]" derivation='Avg' name="[avg:longitud:qk]" pivot='key' type='quantitative' />
            <column-instance column="[latitud]" derivation='Avg' name="[avg:latitud:qk]" pivot='key' type='quantitative' />
            <column-instance column='[Indice]' derivation='User' name="[usr:Indice:qk]" pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='display-field-labels' scope='rows' value='false' />
            <format attr='display-field-labels' scope='cols' value='false' />
          </style-rule>
          <style-rule element='pane'>
            <format attr='background-color' value='#FFFFFF' />
          </style-rule>
          <style-rule element='axis'>
            <format attr='color' value='#6E8894' />
          </style-rule>
          <style-rule element='header'>
            <format attr='color' value='#35505C' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Circle' />
            <encodings>
              <color column="[federated.aeropuertos].[usr:Indice:qk]" />
              <size column="[federated.aeropuertos].[sum:vuelos:qk]" />
              <lod column="[federated.aeropuertos].[none:codigo:nk]" />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.aeropuertos].[avg:latitud:qk]</rows>
        <cols>[federated.aeropuertos].[avg:longitud:qk]</cols>
      </table>
      <simple-id uuid='{C9C999F6-4E77-54E0-92D6-ABCFDC0B6D8F}' />
    </worksheet>
    <worksheet name="El reparto temporal">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#35505C' fontsize='11'>Demora media por hora y dia de la semana</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Tiempo" name='federated.tiempo' />
          </datasources>
          <datasource-dependencies datasource='federated.tiempo'>
            <column datatype='string' name="[etiqueta_hora]" role='dimension' type='nominal' />
            <column datatype='integer' name="[vuelos]" role='measure' type='quantitative' />
            <column datatype='integer' name="[minutos]" role='measure' type='quantitative' />
            <column caption="Dia de la semana" datatype='string' name='[DiaOrdenado]' role='dimension' type='nominal'>
              <calculation class='tableau' formula="STR([dia_semana]) + '. ' + [nombre_dia]" scope-isolation='false' />
            </column>
            <column caption="Demora media de salida (min)" datatype='real' default-format="n#,##0.00" name='[DemoraMedia]' role='measure' type='quantitative'>
              <calculation class='tableau' formula="SUM([minutos]) / SUM([vuelos])" scope-isolation='false' />
            </column>
            <column-instance column="[etiqueta_hora]" derivation='None' name="[none:etiqueta_hora:nk]" pivot='key' type='nominal' />
            <column-instance column="[vuelos]" derivation='Sum' name="[sum:vuelos:qk]" pivot='key' type='quantitative' />
            <column-instance column="[minutos]" derivation='Sum' name="[sum:minutos:qk]" pivot='key' type='quantitative' />
            <column-instance column='[DiaOrdenado]' derivation='None' name="[none:DiaOrdenado:nk]" pivot='key' type='nominal' />
            <column-instance column='[DemoraMedia]' derivation='User' name="[usr:DemoraMedia:qk]" pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='display-field-labels' scope='rows' value='false' />
            <format attr='display-field-labels' scope='cols' value='false' />
          </style-rule>
          <style-rule element='pane'>
            <format attr='background-color' value='#FFFFFF' />
          </style-rule>
          <style-rule element='axis'>
            <format attr='color' value='#6E8894' />
          </style-rule>
          <style-rule element='header'>
            <format attr='color' value='#35505C' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Square' />
            <encodings>
              <color column="[federated.tiempo].[usr:DemoraMedia:qk]" />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.tiempo].[none:etiqueta_hora:nk]</rows>
        <cols>[federated.tiempo].[none:DiaOrdenado:nk]</cols>
      </table>
      <simple-id uuid='{D925C779-1B75-5E7F-8F34-0B83EB50EF7B}' />
    </worksheet>
  </worksheets>
